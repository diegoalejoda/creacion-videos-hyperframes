 "segments": [
  {
   "start": 0.0,
   "end": 4.54,
   "text": "Si eres docente del gobierno, ganas bien pero las deudas y los descuentos no te"
  },
  {
   "start": 4.54,
   "end": 9.34,
   "text": "dejan en paz, esto te interesa. En Credi Ayudarte hemos acompañado casos"
  },
  {
   "start": 9.34,
   "end": 13.16,
   "text": "parecidos al tuyo, profes que tienen un buen salario pero que cuando llega la"
  },
  {
   "start": 13.16,
   "end": 18.0,
   "text": "nómina casi todo se va en descuentos, cooperativas, embargos, tarjetas en"
  },
  {
   "start": 18.0,
   "end": 22.76,
   "text": "mora o deudas que pagan por fuera y el problema no se resuelve pidiendo otro"
  },
  {
   "start": 22.76,
   "end": 26.62,
   "text": "crédito a ciegas. Primero hay que revisar qué está pasando con tu nómina,"
  },
  {
   "start": 26.62,
   "end": 31.06,
   "text": "qué descuentos tienes, qué deudas se pueden negociar, qué obligaciones te están"
  },
  {
   "start": 31.06,
   "end": 36.08,
   "text": "quitando más capacidad y si existe una forma real de ordenar tu situación sin"
  },
  {
   "start": 36.08,
   "end": 40.56,
   "text": "dejarte peor, no te prometemos milagros, no todos los casos aplican, pero si"
  },
  {
   "start": 40.56,
   "end": 45.02,
   "text": "sientes que trabajas todo el mes y aún así no te queda para vivir, escríbenos"
  },
  {
   "start": 45.02,
   "end": 48.34,
   "text": "por whatsapp con la palabra crédito y tendrás una atención inmediata."
  }
 ],
