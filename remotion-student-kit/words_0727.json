 "segments": [
  {
   "start": 0.0,
   "end": 4.58,
   "text": "Estás perdiendo plata cada mes por estas tres cosas y la última te va a sorprender."
  },
  {
   "start": 4.78,
   "end": 11.16,
   "text": "Si tienes tres o cuatro deudas por ahí pequeñas, cada una te cobra por separado estudio, seguro y manejo."
  },
  {
   "start": 11.26,
   "end": 15.84,
   "text": "Si aceptaste un crédito por afán y no te fijaste en qué tasa realmente estás pagando,"
  },
  {
   "start": 16.0,
   "end": 21.54,
   "text": "si hiciste un crédito digital y no te fijaste que el valor que te desembolsaron le sumaron el aval,"
  },
  {
   "start": 21.6,
   "end": 25.3,
   "text": "que puede ser hasta un 30% más del dinero que recibiste."
  },
  {
   "start": 25.46,
   "end": 28.08,
   "text": "A un pensionado que atendimos le sacamos esa cuenta"
  },
  {
   "start": 28.08,
   "end": 31.42,
   "text": "y estaba perdiendo un muy buen porcentaje de lo que ganaba."
  },
  {
   "start": 31.6,
   "end": 36.4,
   "text": "Si recibes pensión o nómina del gobierno, podríamos ayudarte a organizar tus cuotas"
  },
  {
   "start": 36.4,
   "end": 38.18,
   "text": "y si es posible, a que pagues menos."
  },
  {
   "start": 38.48,
   "end": 41.14,
   "text": "Escríbenos al WhatsApp y te responderemos de forma inmediata."
  }
 ]
